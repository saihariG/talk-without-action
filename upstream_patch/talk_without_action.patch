+def _coerce_price(value, agent_id):
+    """Open-weight models sometimes return prices as strings ("93.00"). The original
+    gpt/claude runs returned numbers, so convert numeric strings and drop anything
+    else (treated as no action this hour). Every change is logged for reporting."""
+    if value is None or value == "null" or isinstance(value, (int, float)):
+        return value
+    try:
+        price = float(str(value).strip().lstrip("$"))
+        logging.warning(f"PRICE_COERCED {agent_id}: {value!r} -> {price}")
+        return price
+    except ValueError:
+        logging.warning(f"PRICE_DROPPED {agent_id}: {value!r}")
+        return None
